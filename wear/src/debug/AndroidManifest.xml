<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a test feed the watch the same messages the phone sends (DebugMessageReceiver).
     DUMP is held by adb shell, not by apps, so only a connected computer can use it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugMessageReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
