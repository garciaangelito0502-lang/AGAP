<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the AGAP logo from the research group (design/agap-logo.jpg, outside this repo),
     cut out of its black background, on a transparent background. The monochrome layer (the purple letters only) is used by Android 13+
     themed icons. The layers are PNGs made from the logo at each screen density (D-036). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
