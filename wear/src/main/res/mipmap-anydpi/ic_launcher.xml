<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon (1.1): the research group's logo for version 1.1 (design/agap-logo_for_v1.1.jpg, outside this
     repo): the ear mascot over the AGAP wordmark on purple. The background layer is the logo's own purple, and the
     whole logo is the foreground at 70% of the layer, so the mascot and wordmark stay inside every launcher's mask.
     The monochrome layer (the logo's light parts) is used by Android 13+ themed icons (D-061). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
