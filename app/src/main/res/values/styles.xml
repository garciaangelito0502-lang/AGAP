<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text. Sizes are in sp, so the app text-size setting and the phone's own font size both apply. -->
    <style name="TextAppearance.AGAP.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/agapText</item>
    </style>

    <style name="TextAppearance.AGAP.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/agapText</item>
    </style>

    <style name="TextAppearance.AGAP.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/agapText</item>
    </style>

    <style name="TextAppearance.AGAP.BodySecondary" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/agapTextSecondary</item>
    </style>

    <style name="TextAppearance.AGAP.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/agapTextSecondary</item>
    </style>

    <!-- Base size of caption text; Live Captions (Phase 2) uses the same size -->
    <style name="TextAppearance.AGAP.Caption" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/agapText</item>
    </style>

    <style name="TextAppearance.AGAP.TopBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AGAP.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.AGAP.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.AGAP.TopBar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/agapTopBar</item>
        <item name="titleTextColor">?attr/agapOnTopBar</item>
        <item name="titleTextAppearance">@style/TextAppearance.AGAP.TopBarTitle</item>
        <item name="navigationIconTint">?attr/agapOnTopBar</item>
        <item name="android:minHeight">64dp</item>
    </style>

    <style name="Widget.AGAP.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/agapSurface</item>
        <!-- No elevation: Material 3 would tint the raised bar with the primary colour (lavender) -->
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_item_icon</item>
        <item name="itemTextColor">@color/nav_item_text</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.AGAP.NavLabel</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.AGAP.NavLabel.Active</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- High contrast: no thin purple shapes on black, so the unfilled track is grey -->
    <style name="Widget.AGAP.Slider.HighContrast" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/hc_text</item>
        <item name="trackColorInactive">@color/hc_outline</item>
        <item name="thumbColor">@color/hc_text</item>
        <item name="tickColorActive">@color/hc_background</item>
        <item name="tickColorInactive">@color/hc_background</item>
    </style>

    <!-- Filled button: purple with white text in both themes -->
    <style name="Widget.AGAP.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_background</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="iconTint">@color/button_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- Outlined button: purple outline and text (white in high contrast) -->
    <style name="Widget.AGAP.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/agapAccent</item>
        <item name="iconTint">?attr/agapAccent</item>
        <item name="strokeColor">?attr/agapAccent</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <!-- One button of a toggle group, such as the caption language -->
    <style name="Widget.AGAP.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_background</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="iconTint">@color/toggle_text</item>
        <item name="strokeColor">@color/toggle_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Widget.AGAP.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/agapSurface</item>
        <item name="strokeColor">?attr/agapOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- A tappable list row: at least 64dp tall, full-width touch target -->
    <style name="Widget.AGAP.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.AGAP.RowIcon" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="tint">?attr/agapAccent</item>
    </style>

    <style name="Widget.AGAP.Chevron" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="tint">?attr/agapText</item>
    </style>
</resources>
