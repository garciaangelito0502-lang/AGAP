<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Light theme (default) -->
    <style name="Theme.AGAP" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_tint</item>
        <item name="colorOnPrimaryContainer">@color/brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_tint</item>
        <item name="colorOnSecondaryContainer">@color/brand</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="agapBackground">@color/background</item>
        <item name="agapSurface">@color/surface</item>
        <item name="agapText">@color/text</item>
        <item name="agapTextSecondary">@color/text_secondary</item>
        <item name="agapOutline">@color/outline</item>
        <item name="agapTopBar">@color/brand</item>
        <item name="agapOnTopBar">@color/on_brand</item>
        <item name="agapAccent">@color/brand</item>
        <item name="agapIconCircle">@color/brand_tint</item>
        <item name="agapOnIconCircle">@color/brand</item>
        <item name="agapCaptionBackground">@color/surface</item>
        <item name="agapNote">@color/brand_tint</item>
        <item name="agapEmergencyRow">@color/emergency_tint</item>
        <item name="agapEmergencyInk">@color/emergency_ink</item>
        <item name="agapTrafficRow">@color/traffic_tint</item>
        <item name="agapTrafficInk">@color/traffic_ink</item>
        <item name="agapHouseholdRow">@color/household_tint</item>
        <item name="agapHouseholdInk">@color/household_ink</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="toolbarStyle">@style/Widget.AGAP.TopBar</item>
        <item name="bottomNavigationStyle">@style/Widget.AGAP.BottomNav</item>
        <item name="materialButtonStyle">@style/Widget.AGAP.Button</item>
        <item name="materialCardViewStyle">@style/Widget.AGAP.Card</item>
    </style>

    <!-- Full-screen alert over the app. The same strong category colours in both display modes
         (design note), so it does not follow the high-contrast theme. No window animation: the
         alert appears at once, and nothing slides or flashes. -->
    <style name="Theme.AGAP.AlertOverlay" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/Widget.AGAP.Button</item>
    </style>

    <!-- High-contrast theme: black background, white text. Purple appears only as a filled
         shape behind white text or icons (buttons, the selected tab, the Home icon circles). -->
    <style name="Theme.AGAP.HighContrast" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/hc_text</item>
        <item name="colorOnPrimary">@color/hc_background</item>
        <item name="colorPrimaryContainer">@color/brand</item>
        <item name="colorOnPrimaryContainer">@color/on_brand</item>
        <item name="colorSecondary">@color/hc_text</item>
        <item name="colorOnSecondary">@color/hc_background</item>
        <item name="colorSecondaryContainer">@color/brand</item>
        <item name="colorOnSecondaryContainer">@color/on_brand</item>
        <item name="android:colorBackground">@color/hc_background</item>
        <item name="colorOnBackground">@color/hc_text</item>
        <item name="colorSurface">@color/hc_surface</item>
        <item name="colorSurfaceContainer">@color/hc_surface</item>
        <item name="colorOnSurface">@color/hc_text</item>
        <item name="colorOnSurfaceVariant">@color/hc_text_secondary</item>
        <item name="colorOutline">@color/hc_outline</item>
        <item name="colorOutlineVariant">@color/hc_outline</item>

        <item name="agapBackground">@color/hc_background</item>
        <item name="agapSurface">@color/hc_surface</item>
        <item name="agapText">@color/hc_text</item>
        <item name="agapTextSecondary">@color/hc_text_secondary</item>
        <item name="agapOutline">@color/hc_outline</item>
        <item name="agapTopBar">@color/hc_background</item>
        <item name="agapOnTopBar">@color/hc_text</item>
        <item name="agapAccent">@color/hc_text</item>
        <item name="agapIconCircle">@color/brand</item>
        <item name="agapOnIconCircle">@color/on_brand</item>
        <item name="agapCaptionBackground">@color/hc_background</item>
        <item name="agapNote">@color/hc_surface</item>
        <item name="agapEmergencyRow">@color/hc_surface</item>
        <item name="agapEmergencyInk">@color/hc_emergency</item>
        <item name="agapTrafficRow">@color/hc_surface</item>
        <item name="agapTrafficInk">@color/hc_traffic</item>
        <item name="agapHouseholdRow">@color/hc_surface</item>
        <item name="agapHouseholdInk">@color/hc_household</item>

        <item name="android:windowBackground">@color/hc_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="sliderStyle">@style/Widget.AGAP.Slider.HighContrast</item>
        <item name="toolbarStyle">@style/Widget.AGAP.TopBar</item>
        <item name="bottomNavigationStyle">@style/Widget.AGAP.BottomNav</item>
        <item name="materialButtonStyle">@style/Widget.AGAP.Button</item>
        <item name="materialCardViewStyle">@style/Widget.AGAP.Card</item>
    </style>
</resources>
