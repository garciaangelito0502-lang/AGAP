<?xml version="1.0" encoding="utf-8"?>
<!-- Demonstration Mode banner (contract 1.9). Shown on every screen while the mode is on; the
     striped background is set by DemoBanner. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demo_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/demo_banner_title"
        android:textAllCaps="true"
        android:textColor="@color/on_brand"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/demo_banner_detail"
        android:textColor="@color/on_brand"
        android:textSize="13sp" />
</LinearLayout>
