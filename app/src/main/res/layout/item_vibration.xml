<?xml version="1.0" encoding="utf-8"?>
<!-- One category on the Vibration Patterns guide: badge and name, the pattern in words and as bars,
     then a Try button. Stacked, so the words keep the full width at the largest text size.
     Colours are set in code. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vibration_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Read by screen readers as one item: name, then the pattern in words -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:screenReaderFocusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:id="@+id/vibration_shape"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/vibration_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/vibration_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.AGAP.Title"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/vibration_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.AGAP.Body" />

            <ph.agap.app.ui.alerts.VibrationBarsView
                android:id="@+id/vibration_bars"
                android:layout_width="180dp"
                android:layout_height="14dp"
                android:layout_marginTop="12dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/vibration_try"
            style="@style/Widget.AGAP.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="@string/vibration_try"
            app:icon="@drawable/ic_vibration" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
