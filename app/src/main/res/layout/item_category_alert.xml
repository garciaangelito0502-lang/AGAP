<?xml version="1.0" encoding="utf-8"?>
<!-- One of the 13 alerts on the Sound Categories screen: icon, name, meaning and the YAMNet classes
     it listens for. Read by screen readers as one item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:screenReaderFocusable="true">

    <ImageView
        android:id="@+id/sound_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sound_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AGAP.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sound_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AGAP.Body" />

        <TextView
            android:id="@+id/sound_classes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.AGAP.BodySecondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
