<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar used by every screen. The holder takes the status-bar padding (see BaseActivity),
     so the toolbar itself keeps a fixed height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/agapTopBar"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/agapOutline" />
</LinearLayout>
