<?xml version="1.0" encoding="utf-8"?>
<!-- The floating caption window over other apps (Phase 11): plain white or black like the
     caption box, the user's text size. The top bar moves it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_captions"
        android:elevation="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/floating_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/floating_drag"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/floating_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.AGAP.SectionLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/floating_open"
                style="@style/Widget.AGAP.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:minHeight="48dp"
                android:text="@string/floating_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/floating_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/floating_stop"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:icon="@drawable/ic_stop" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/agapOutline" />

        <ScrollView
            android:id="@+id/floating_scroll"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:importantForAccessibility="no">

            <TextView
                android:id="@+id/floating_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextAppearance.AGAP.Caption" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
